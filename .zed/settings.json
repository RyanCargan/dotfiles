{
  "lsp": {
    "nil": {
      "initialization_options": {
        "formatting": {
          "command": ["nixpkgs-fmt"],
        },
      },
    },
    "nixd": {
      "settings": {
        "diagnostic": {
          "suppress": [
            "sema-unused-def-lambda-noarg-formal"
          ]
        }
      }
    }
  },
  "languages": {
    "Nix": {
      "format_on_save": "on",
    },
  },
}
